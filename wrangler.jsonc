{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-ping",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first, so every page gets its security
    // headers (src/worker/security-headers.ts), except the hashed JS and CSS
    // bundles, which static assets serve on their own (public/_headers).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/12 * * * *"]
  },
  "vars": {
    // Your Cloudflare Workers plan: "free" or "paid". It sets how much one cron
    // run may spend (src/worker/lib/budget.ts, docs/FREE_TIER.md): on Free a run
    // checks about 7 monitors and defers the rest to the next tick.
    "WORKERS_PLAN": "free",
    // Leave "false". Only the canonical install (openping.n8builds.dev) sets it
    // to "true" to collect the OpenPing Hosted waitlist (docs/HOSTED_PLAN.md).
    "WAITLIST_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-ping",
      // Replace with the id printed by `wrangler d1 create open-ping` before
      // deploying. Left as an obvious sentinel (not a zero-UUID) so a missed
      // setup step fails loudly instead of with a cryptic "database not found".
      // Local dev (`--local`) uses database_name, so this value is remote-only.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
