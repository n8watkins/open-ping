{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-ping",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // The Worker serves the app shell for client routes itself
    // (src/worker/index.ts), so a missing file is a real 404, not the app.
    "not_found_handling": "none",
    // Every request runs the Worker first, so every page gets its security
    // headers (src/worker/security-headers.ts), except the hashed JS and CSS
    // bundles, which static assets serve on their own (public/_headers).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/12 * * * *"]
  },
  "vars": {
    // Your Cloudflare Workers plan: "free" or "paid". It sets how much one cron
    // run may spend (src/worker/lib/budget.ts, docs/FREE_TIER.md): on Free a run
    // checks about 24 monitors and defers the rest to the next tick.
    "WORKERS_PLAN": "free",
    // Leave "false". Only the canonical install (openping.n8builds.dev) sets it
    // to "true" to collect the OpenPing Hosted waitlist (docs/HOSTED_PLAN.md).
    "WAITLIST_ENABLED": "false",
    // What a signed-out visitor sees at "/": "status" shows this install's own
    // default status page. Leave it. Only the canonical install sets "landing"
    // (the OpenPing marketing page and its click counts); docs/INSTALL.md.
    "HOME_PAGE": "status",
    // Leave empty. Only the canonical install sets it, to the OpenPing Hosted
    // sign-up page, once Hosted opens: its landing page then offers the free
    // trial instead of the waitlist (src/shared/hosted-offer.ts).
    "HOSTED_SIGNUP_URL": "",
    // Where a failed check is confirmed from before it opens an incident: these
    // Durable Object regions, in order (docs/SECOND_REGION.md). The run asks one
    // whose data center isn't its own, so one location's network trouble
    // doesn't page you. "off" re-checks where the check ran.
    "CONFIRM_REGIONS": "enam,weur"
  },
  // The per-region re-checkers behind CONFIRM_REGIONS (src/worker/region-probe.ts).
  // SQLite-backed Durable Objects are on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "REGION_PROBE", "class_name": "RegionProbe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegionProbe"] }],
  // Caps the landing page's click counter per visitor (src/worker/routes/events.ts),
  // so it needs no database write to rate limit. Only used when HOME_PAGE is
  // "landing". namespace_id is any integer unique within your Cloudflare account.
  "ratelimits": [
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "4271",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-ping",
      // No database_id on purpose: this file is a public template, and an id
      // belongs to one Cloudflare account. On deploy, Wrangler binds the
      // database named above, creating it the first time (its automatic
      // provisioning), and `wrangler d1` commands look it up by that name.
      // The Deploy to Cloudflare button creates it the same way. To pin your
      // own id without editing this file, use deploy.local.json
      // (scripts/prod-config.mjs, docs/INSTALL.md).
      "migrations_dir": "migrations"
    }
  ]
}
