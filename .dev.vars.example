# OpenPing local development secrets.
#
# Copy this file to `.dev.vars` (which is gitignored) and fill in real values:
#
#     cp .dev.vars.example .dev.vars
#
# `wrangler` / `npm run dev` loads these into the Worker as `env` bindings,
# mirroring the production secrets you set with `wrangler secret put <NAME>`.
# Anything left blank or omitted makes that feature "not configured" locally.
# The app boots for diagnostics, but setup cannot complete without MASTER_KEY.
#
# Only the two required secrets are uncommented: the Deploy to Cloudflare
# button asks for every uncommented key here (package.json "cloudflare"
# describes each). Uncomment the others in your .dev.vars as you need them.

# --- Required for anything beyond a bare boot ---

# AES-GCM master key used to encrypt sensitive config at rest (base64, 32 bytes).
# Generate one with:  openssl rand -base64 32
MASTER_KEY=

# Only while rotating MASTER_KEY: the old key, used to read but never to write.
# Delete it once Settings > Encryption keys says it is no longer needed
# (docs/SECURITY.md, "Rotating MASTER_KEY").
# MASTER_KEY_PREVIOUS=

# One-time credential that protects the unauthenticated first-run wizard.
# Generate one with: openssl rand -base64 32
SETUP_TOKEN=

# --- GitHub OAuth (sign-in) ---
# Create a GitHub OAuth app and set the callback to ${APP_URL}/auth/github/callback.
# For local dev that's usually http://localhost:5173/auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Administrator allowlist (at least ONE identity is required) ---
# The GitHub login and/or email allowed to sign in as the single admin.
# ADMIN_GITHUB_LOGIN=
# ADMIN_EMAIL=

# --- Email + magic links (Resend) ---
# RESEND_API_KEY=

# --- Public base URL of this installation ---
# Local dev default (or enter it in the local setup wizard):
# APP_URL=http://localhost:5173

# --- Admin API token for the CLI / automation (optional) ---
# When set, `Authorization: Bearer <API_TOKEN>` grants full admin API access
# (used by scripts/op.mjs). Treat it like a password; rotate by changing it.
# Generate one with:  openssl rand -base64 32
# API_TOKEN=

# --- Web Push (optional) ---
# VAPID keys can instead be generated in-app under Integrations and stored in
# settings. Set them here only if you want to manage them as secrets.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# --- OpenPing Hosted mode, for working on it locally (optional) ---
# Runs this OpenPing the way the Hosted platform does (docs/hosted/CONTRACT.md).
# Leave these out for a normal install. HOSTED_DEV_TENANT stands in for the
# props the platform passes; only `npm run dev` reads it, never a deployment.
# HOSTED_MODE=1
# TENANT_ID=abcdefgh12345678
# HANDOFF_PUBLIC_KEY=
# HOSTED_DEV_TENANT={"id":"abcdefgh12345678","slug":"acme","status":"trial","plan":"trial","limits":{"monitors":5,"statusPages":1,"minIntervalMinutes":12,"channelKinds":["email"],"emailsPerDay":50},"trialEndsAt":null,"urls":{"account":"http://localhost:5173/","billing":"http://localhost:5173/","upgrade":"http://localhost:5173/","signIn":"http://localhost:5173/login","signOut":"http://localhost:5173/"}}
