<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The app: dark navy behind the web view and the system bars. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/canvas</item>
        <item name="colorPrimaryDark">@color/canvas</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <!-- Capacitor's BridgeActivity switches to this theme in onCreate. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The launch screen (androidx.core.splashscreen): the mark on navy. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
