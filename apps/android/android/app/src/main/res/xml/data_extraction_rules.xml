<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in a backup or a device transfer: the web view's
  sessions and the sign-in in progress are this phone's alone. On a new
  phone, add your OpenPings again and sign in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
