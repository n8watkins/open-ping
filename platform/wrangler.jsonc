{
  // The OpenPing Hosted platform Worker (docs/HOSTED_BUILD_PLAN.md, B1).
  // NOT DEPLOYED YET. Nothing in this file has been created in any Cloudflare
  // account: the database, the dispatch namespace and the queue below are
  // placeholders the owner creates later (platform/README.md, "Owner setup").
  // There are no account ids or database ids here on purpose, the same as the
  // root wrangler.jsonc: an id belongs to one account, and this file is public.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openping-platform",
  "main": "src/index.ts",
  // 2025-11-17 or later turns on ctx.exports, which the platform uses to hand
  // each customer's OpenPing its capability stub (src/index.ts, TenantPlatform).
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // Customers reach the platform only through its routes on HOSTED_DOMAIN
  // (added with the domain, decision D2), never a workers.dev address.
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    // The Hosted domain (decision D2, docs/hosted/DECISIONS.md): the platform
    // serves app.<HOSTED_DOMAIN> itself and dispatches <slug>.<HOSTED_DOMAIN>
    // to that customer's OpenPing. ".invalid" can never resolve, so nothing
    // routes here until the owner buys the domain and sets it.
    "HOSTED_DOMAIN": "openping-hosted.invalid",
    // The dispatch namespace's name, for the Cloudflare API calls that upload
    // and delete user Workers (src/provisioning.ts); the same as the binding's.
    "DISPATCH_NAMESPACE": "openping-tenants",
    // base64url of the raw 32-byte Ed25519 public key every tenant verifies
    // hand-off tokens with. Public by design; empty until the owner makes the
    // pair (owner action O6), and provisioning stays off until it is set.
    "HANDOFF_PUBLIC_KEY": "",
    // "open" lets new accounts be made at app.<domain>/sign-up; anything else
    // lets only existing accounts sign in (staging testers, then launch).
    "SIGN_UPS": "closed",
    // The From of sign-in emails, on a domain verified in Resend; email
    // sign-in is off while it (or the RESEND_API_KEY secret) is empty.
    "MAIL_FROM": "",
    // The platform's GitHub OAuth app; GitHub sign-in is off while it (or the
    // GITHUB_CLIENT_SECRET secret) is empty.
    "GITHUB_CLIENT_ID": "",
    // Who may open the admin console at app.<domain>/admin (src/admin/):
    // platform account ids (acc_...) or emails, separated by commas. Prefer
    // the account id here, since this file is public; an email can go in a
    // secret of the same name instead. Empty means nobody: /admin is a 404.
    "PLATFORM_OWNERS": "",
    // The credential ids of the owner's own passkeys (comma separated). Only
    // a sign-in with one of these opens the admin console; the console's
    // "Confirm it's you" page lists the owner's passkey ids to copy. Public
    // ids, safe here.
    "PLATFORM_OWNER_PASSKEYS": ""
  },
  // Every minute: the scheduler enqueues the due customers (src/scheduling.ts),
  // and the safety net for provisioning (src/provisioning.ts) runs alongside.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Accounts, tenants, subscriptions, escrowed keys, audit events and rate
  // limits (migrations/). Never monitoring data. Created later by the owner;
  // binding by name, like the root config, until then.
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "openping-platform",
      "migrations_dir": "migrations"
    }
  ],
  // One user Worker per customer, named t-<tenant id>. Workers for Platforms
  // must be on (owner action O1) before this namespace can be created.
  "dispatch_namespaces": [
    {
      "binding": "TENANTS",
      "namespace": "openping-tenants"
    }
  ],
  // Tenant bundles, one per OpenPing release, written by the release runner
  // (C1) and read by provisioning (layout in src/bundle.ts).
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "openping-tenant-bundles"
    }
  ],
  // The per-minute scheduler puts each due customer on openping-schedule (B4).
  // Provisioning runs (src/provisioning-queue.ts): one message per new
  // tenant and per retry. A consumer gets minutes per batch, where the
  // sign-up request's waitUntil would be cut after 30 seconds.
  "queues": {
    "producers": [
      {
        "binding": "SCHEDULE_QUEUE",
        "queue": "openping-schedule"
      },
      {
        "binding": "PROVISION_QUEUE",
        "queue": "openping-provision"
      }
    ],
    "consumers": [
      // The scheduler (src/scheduling.ts): a batch of due tenants, called all
      // at once, each with its own timeout (40 s at 1-minute checks, 90 s
      // otherwise), so a batch takes at most about 90 s of wall time and
      // very little CPU. A tenant call is never retried through the queue
      // (the scheduler backs off instead); max_retries covers the platform's
      // own database failing before the call, and a consumer that dies.
      {
        "queue": "openping-schedule",
        "max_batch_size": 25,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "openping-provision",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 20
      }
    ]
  }
  // Secrets, set later with `wrangler secret put` from the owner's machine,
  // never in this file: HANDOFF_SIGNING_KEY, RESEND_API_KEY and
  // GITHUB_CLIENT_SECRET (B2), PLATFORM_KEY, CF_ACCOUNT_ID and CF_API_TOKEN
  // (B3), STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (B5).
}
